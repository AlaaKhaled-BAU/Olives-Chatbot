# Required — get from DeepSeek dashboard
DEEPSEEK_API_KEY=

# Pinned tenant (baked work/105/ in image)
CHATBOT_CLIENT=105

# Option B only — default targets host SQL from inside Docker (not ".")
# DB_HOST=host.docker.internal
# DB_PORT=1433

# Option A only — must match olives-mssql-demo (local mssql uses DB_SA_PASSWORD)
DB_SA_PASSWORD=OlivesDemo_SA_2026!
# MSSQL_SA_PASSWORD=   # optional override; defaults to DB_SA_PASSWORD

# Optional model overrides
# CHATBOT_MODEL_FAST=deepseek-v4-flash
# CHATBOT_MODEL_HEAVY=deepseek-v4-pro
