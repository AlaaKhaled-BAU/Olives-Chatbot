# Non-secret defaults. The LLM key never lives here — see gateway/.env.example.
GATEWAY_URL=http://localhost:4000
DB_HOST=127.0.0.1
DB_PORT=14330
DB_NAME=chatbot_db

# Per-client tenant tokens (C2, 2026-07-26): clients/<name>.yaml sets
# api_token_env: SOME_VAR_NAME, and the actual token value lives ONLY here in
# .env (gitignored) -- never in clients/*.yaml (git-tracked). One var per
# client. Generate a value with:
#   python3.13 -c "import secrets;print(secrets.token_urlsafe(32))"
OLIVES_TOKEN_MOREC=
OLIVES_TOKEN_RUKN=
