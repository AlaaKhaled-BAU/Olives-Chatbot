# Non-secret defaults. Secrets (SA password, API keys) go in .env only.
GATEWAY_URL=http://localhost:20128/v1
GATEWAY_API_KEY=
# Pin one model alias for answer accuracy — the app never load-balances per token.
# Configure OmniRoute/LiteLLM with a single primary deployment; fallback only on outage.
# Avoid OmniRoute auto/* free tiers (502s / rate limits). Paid picks for this agent (Aug 2026):
#   LiteLLM gateway: CHATBOT_MODEL=chatbot  (gemini-2.5-flash; fallback chatbot-fallback → deepseek-v4-flash)
#   OmniRoute direct: gemini-2.5-flash primary, deepseek-v4-flash fallback — or openai/gpt-4.1-mini
CHATBOT_MODEL=auto/best-coding

# Pinned tenant — server loads this client's clients/*.yaml only (browser cannot switch).
CHATBOT_CLIENT=morec

# Native SQL Server (production-like). Port 1433 = local install / `mssql` container.
# Port 14330 = drift-tool Docker scratch DB (setup/01_db_up.py --mode docker).
DB_HOST=127.0.0.1
DB_PORT=1433
DB_SA_USER=sa
DB_SA_PASSWORD=
SQL_SNAPSHOT_MOUNT=/snapshots
