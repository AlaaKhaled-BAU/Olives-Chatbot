# Non-secret defaults. Secrets (SA password, API keys) go in .env only.
# DeepSeek direct — OmniRoute/LiteLLM removed 2026-08. Key lives in .env ONLY.
DEEPSEEK_API_KEY=
CHATBOT_MODEL_FAST=deepseek-v4-flash
# Heavy model: rescue/async gear only, never interactive turns (plans/deepseek_swap_parallel_plan.md)
CHATBOT_MODEL_HEAVY=deepseek-v4-pro

# Pinned tenant — server loads this client's clients/*.yaml only (browser cannot switch).
CHATBOT_CLIENT=morec
# DeepSeek prefix-cache id. session = one id per chat (default).
# tenant = one id per CHATBOT_CLIENT + CompanyID. Session text stays out of the cached prefix.
# Rollback: set this back to session and restart. No schema or prompt change.
CHATBOT_CACHE_SCOPE=session

# HTTP listen port for run.ps1 / run.sh. The app reads this from .env.
# SQL Server is a different port (DB_PORT below).
PORT=8100

# Native SQL Server (production-like). Port 1433 = local install / `mssql` container.
# Port 14330 = drift-tool Docker scratch DB (setup/01_db_up.py --mode docker).
DB_HOST=127.0.0.1
DB_PORT=1433
# Runtime login. core/sql.py reads these. If DB_PASSWORD is empty it falls back to work/ro_password.txt.
DB_USER=chatbot_ro
DB_PASSWORD=
# Setup scripts only. The running bot does not use SA.
DB_SA_USER=sa
DB_SA_PASSWORD=
SQL_SNAPSHOT_MOUNT=/snapshots
