# Non-secret defaults. Secrets (SA password, API keys, tokens) go in .env only.
GATEWAY_URL=http://localhost:20128/v1
CHATBOT_MODEL=auto/best-coding

# Native SQL Server (production-like). Port 1433 = local install / `mssql` container.
# Port 14330 = drift-tool Docker scratch DB (setup/01_db_up.py --mode docker).
DB_HOST=127.0.0.1
DB_PORT=1433
DB_SA_USER=sa
DB_SA_PASSWORD=
SQL_SNAPSHOT_MOUNT=/snapshots

# Per-client tenant tokens (C2): value in .env only; clients/*.yaml names api_token_env.
OLIVES_TOKEN_MOREC=
OLIVES_TOKEN_RUKN=
